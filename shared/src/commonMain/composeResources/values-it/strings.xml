    <string name="onboarding_env_title">Dove coltiva?</string>
    <string name="onboarding_env_text">Sillon adatta il calendario e i consigli a seconda che coltiviate in piena terra, in vaso su un balcone o in casa.</string>
    <string name="onboarding_outdoor_title">Piena terra / Giardino</string>
    <string name="onboarding_outdoor_text">Aiuole o file, calendario basato sulle ultime gelate e rotazione delle famiglie.</string>
    <string name="onboarding_balcony_title">Balcone / Terrazza</string>
    <string name="onboarding_balcony_text">Coltivazione in vasi e fioriere, calendario basato sulle gelate con indicazioni su esposizione e annaffiatura.</string>
    <string name="onboarding_indoor_title">In casa (appartamento)</string>
    <string name="onboarding_indoor_text">Davanzale o lampada per piante: semine possibili tutto l’anno, senza dipendere dalle gelate.</string>
    <string name="onboarding_place_title_balcony">Dove si trova il vostro balcone?</string>
    <string name="onboarding_place_title_garden">Dove si trova il vostro orto?</string>
    <string name="onboarding_place_text">Sillon calcola tutte le semine sulla data media delle ultime gelate del vostro dipartimento. Nulla lascia il vostro telefono.</string>
    <string name="onboarding_later">Lo imposterò più tardi</string>
    <string name="onboarding_reminder_title">Un promemoria quando è il momento?</string>
    <string name="onboarding_reminder_text">Il sabato mattina Sillon può dirvi quali semine e piantagioni iniziano nelle prossime due settimane. Nessun messaggio se non c’è nulla da fare.</string>
    <string name="onboarding_reminder_hint">Potrete cambiare idea nelle Impostazioni.</string>
